# Server Configuration
PORT=3000

# Trusted reverse-proxy hops for rate limiting (optional, default 0).
# Number of trusted proxies / load balancers in front of the app. When 0
# (or unset), the rate limiter keys on the raw socket address and ignores
# X-Forwarded-For. Set to the number of trusted proxies to extract the real
# client IP from X-Forwarded-For (e.g. 1 when behind a single load balancer).
TRUST_PROXY_HOPS=0

# Database Connection (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homemanagement

# Better Auth Configuration
# Generate a random 32+ character string for the secret
# Command: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-minimum-32-characters

# The base URL where your backend is running
BETTER_AUTH_URL=http://localhost:3000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Seed Admin Account (used by `npm run db:seed`)
# Signup is disabled, so the seed script provisions the sole admin account.
# These MUST be set before running the seed script - there are no defaults.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
# Optional display name (defaults to "Admin")
SEED_ADMIN_NAME=Admin

# SMTP Configuration (for password reset emails)
# Gmail example - requires App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Home Management <your-email@gmail.com>"

# Alternative SMTP providers:
# Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# Yahoo: SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=587
# Custom: Use your mail server's SMTP settings

# Async recipe import is handled by a pg-boss job queue stored in the same
# PostgreSQL database (DATABASE_URL above) and processed by a separate worker
# process (`npm run worker:start`). No extra service is required.
# Optional: the schema pg-boss uses for its tables (defaults to "pgboss").
# PGBOSS_SCHEMA=pgboss

# --- Worker process -------------------------------------------------------
# Only DATABASE_URL is required by the worker; it does not need the auth or
# SMTP variables above. Deployment steps: docs/worker-deployment.md
#
# Port for the worker's own /health endpoint (default 3001). Must differ from
# PORT when the API and worker share a host, as they do in local dev.
# WORKER_HEALTH_PORT=3001
#
# How long a worker may go without completing a poll before /health returns
# 503 (default 120000). Do not set this below ~60000: pg-boss relaxes an idle
# NOTIFY-active queue to a 30s backstop poll, so a healthy but idle worker is
# routinely up to 30s stale and a tighter threshold will flap.
# WORKER_HEALTH_STALE_MS=120000
#
# Set to "true" to disable the health endpoint entirely (not recommended --
# without it the platform cannot distinguish a working worker from a hung one).
# WORKER_HEALTH_DISABLE=false
